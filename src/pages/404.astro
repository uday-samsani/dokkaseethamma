---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import { Button } from "@/components/ui/button";
---

<Layout 
  title="Page Not Found" 
  description="Sorry, the page you're looking for doesn't exist."
>
  <Navigation />
  
  <section class="min-h-[70vh] flex items-center justify-center pt-32 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="text-9xl font-bold text-golden-200 dark:text-golden-900 mb-4">404</div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-earth-900 dark:text-gray-100 mb-6">
        Page Not Found
      </h1>
      <p class="text-earth-600 dark:text-gray-400 text-lg mb-8 max-w-md mx-auto">
        Sorry, we couldn't find the page you're looking for. It might have been moved or doesn't exist.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/">
          <Button size="lg" className="bg-golden-500 hover:bg-golden-600 text-white rounded-full px-8">
            Go Home
          </Button>
        </a>
        <a href="/contact">
          <Button size="lg" variant="outline" className="border-golden-500 text-golden-700 hover:bg-golden-50 dark:text-golden-400 dark:border-golden-500/50 rounded-full px-8">
            Contact Us
          </Button>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
